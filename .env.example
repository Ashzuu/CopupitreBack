# ==============================================================================
# COPUPITRE BACKEND - CONFIGURATION D'ENVIRONNEMENT
# ==============================================================================
# Copiez ce fichier vers .env et ajustez les valeurs selon votre serveur :
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL (préexistante sur le serveur ou distante)
# ------------------------------------------------------------------------------
# DB_HOST :
# - Si le backend tourne dans Docker et PostgreSQL tourne directement sur l'hôte :
#   utilisez 'host.docker.internal' (résolu automatiquement via extra_hosts dans docker-compose)
#   ou l'adresse IP de la passerelle Docker (ex: 172.17.0.1) / l'IP de votre serveur.
# - Si vous lancez le backend directement en local sans Docker (IDE, mvn, java -jar) :
#   utilisez 'localhost'.
# - Si PostgreSQL est hébergé sur une autre machine : indiquez son IP ou nom d'hôte.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=copupitre
DB_USER=postgres
DB_PASSWORD=admin
DB_SCHEMA=main

# ------------------------------------------------------------------------------
# 2. Port d'exposition de l'API Backend
# ------------------------------------------------------------------------------
BACKEND_PORT=40080

# ------------------------------------------------------------------------------
# 3. Sécurité & Authentification JWT
# ------------------------------------------------------------------------------
JWT_SECRET=superSecretKeyForCopupitreApplicationAuthenticationWithHS256Algorithm1234567890!
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 4. Dossier de Logs
# ------------------------------------------------------------------------------
# Dans le conteneur Docker : /app/logs (monté automatiquement sur ./logs de l'hôte)
# Hors conteneur : logs
LOG_PATH=/app/logs

# ------------------------------------------------------------------------------
# 5. Configuration CORS (Origines frontend autorisées séparées par des virgules)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:40000,http://localhost:4000,http://localhost
