# ==============================================================================
# COPUPITRE BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values according to your environment:
#   cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=copupitre-db
DB_PORT=5432
DB_NAME=copupitre
DB_USER=copupitre
DB_PASSWORD=copupitre_secret
DB_SCHEMA=main

# Exposed Ports
BACKEND_PORT=40080

# Security & JWT Configuration
JWT_SECRET=superSecretKeyForCopupitreApplicationAuthenticationWithHS256Algorithm1234567890!
JWT_EXPIRATION=86400000

# Logging Directory (Inside container: /app/logs, mounted on host: ./logs)
LOG_PATH=/app/logs

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:40000,http://localhost:4000,http://localhost
